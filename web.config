<?xml version="1.0" encoding="UTF-8"?>
<configuration>
  <system.webServer>
    <rewrite>
      <rules>
        <!-- Use one canonical public entry point. -->
        <rule name="TapTrack canonical application path" stopProcessing="true">
          <match url="^attendance-system$" />
          <action type="Redirect" url="/attendance-system/" redirectType="Permanent" />
        </rule>

        <!-- Remove the public prefix before forwarding the request to Express. -->
        <rule name="TapTrack prefixed reverse proxy" stopProcessing="true">
          <match url="^attendance-system(?:/(.*))?$" />
          <action
            type="Rewrite"
            url="http://127.0.0.1:4000/{R:1}"
            appendQueryString="true"
            logRewrittenUrl="true" />
        </rule>
      </rules>
    </rewrite>
  </system.webServer>
</configuration>
