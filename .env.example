PORT=4000
PUBLIC_BASE_PATH=/attendance-system
HTTPS_PORT=4443
HTTPS_CERT_PATH=
HTTPS_KEY_PATH=
HTTPS_CA_PATH=
HTTPS_PFX_PATH=
HTTPS_PFX_PASSPHRASE=
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=attendance_system
# Optional registrar source for direct student imports. The configured read-only
# view must expose SchoolID, LastName, FirstName, MiddleName, BirthDate,
# CourseCode, YearLevel, SectionName, Gender, InstitutionalEmail, Photo,
# SchoolYear, and Semester. SectionName is required for Grade 1 to Grade 12.
# Photo may be varbinary/image data containing JPEG, PNG, or WebP.
MSSQL_SERVER=
MSSQL_PORT=1433
MSSQL_DATABASE=
MSSQL_USER=
MSSQL_PASSWORD=
MSSQL_STUDENT_VIEW=dbo.vw_TapTrackStudents
# Compatibility fallback when an older view does not expose Photo.
MSSQL_STUDENT_TABLE=dbo.Student
MSSQL_ENCRYPT=false
MSSQL_TRUST_SERVER_CERTIFICATE=false
# Allow extra time when a confirmed import transfers student photo binaries.
MSSQL_REQUEST_TIMEOUT=300000
JWT_SECRET=replace-with-a-long-random-secret
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_WORKSPACE_DOMAIN=ndmu.edu.ph
GOOGLE_REDIRECT_URI=http://localhost:4000/api/auth/google/callback
# Production requests are HTTPS-only. Set this only for an isolated legacy LAN.
ALLOW_INSECURE_HTTP=false
# Apply database.sql during deployment. Runtime DDL is disabled in production.
ALLOW_RUNTIME_DDL=false
